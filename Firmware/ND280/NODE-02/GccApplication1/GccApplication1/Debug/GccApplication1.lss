#include "board_id.h"

void board_id_init(void)
{
    /* bit0..bit3 = PC0..PC3; bit4 = PD2. External 100 kohm pull-ups. */
    DDRC &= ~((1 << PC0) | (1 << PC1) | (1 << PC2) | (1 << PC3));
