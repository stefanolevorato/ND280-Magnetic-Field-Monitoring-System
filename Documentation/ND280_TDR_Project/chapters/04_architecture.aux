\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces \textbf  {SV-01 -- Overall System Architecture.} The monitoring system is composed of autonomous intelligent acquisition nodes connected through a segmented communication network. A Coordinator performs node discovery and data aggregation, while the ND280 Monitor provides the user-facing engineering interface.}}{17}{figure.caption.6}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:sv01}{{4.1}{17}{\textbf {SV-01 -- Overall System Architecture.} The monitoring system is composed of autonomous intelligent acquisition nodes connected through a segmented communication network. A Coordinator performs node discovery and data aggregation, while the ND280 Monitor provides the user-facing engineering interface}{figure.caption.6}{}}
\newlabel{fig:sv01@cref}{{[figure][1][4]4.1}{[1][16][]17}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces \textbf  {SV-02 -- Intelligent Acquisition Node.} TWI1 is dedicated to the local magnetic-sensor subsystem through the TCA9548A multiplexer, while TWI0 is reserved for the segmented inter-board network through the TCA9517A. Hardware identity, operating role, OLED status and persistent calibration are local node resources.}}{18}{figure.caption.7}\protected@file@percent }
\newlabel{fig:sv02}{{4.2}{18}{\textbf {SV-02 -- Intelligent Acquisition Node.} TWI1 is dedicated to the local magnetic-sensor subsystem through the TCA9548A multiplexer, while TWI0 is reserved for the segmented inter-board network through the TCA9517A. Hardware identity, operating role, OLED status and persistent calibration are local node resources}{figure.caption.7}{}}
\newlabel{fig:sv02@cref}{{[figure][2][4]4.2}{[1][16][]18}{}{}{}}
